# ARA OCR — Environment Configuration
# Copy this file to .env and adjust values as needed

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ara_ocr

# Data directories (relative to project root)
DATA_DIR=./data
MODELS_DIR=./models

# Model versions — mandatory for traceability
OCR_MODEL_VERSION=paddleocr_mr_en_v1
CLASSIFIER_MODEL_VERSION=layoutxlm_ara_v1
PIPELINE_VERSION=0.1.0

# Classification confidence threshold
# Below this threshold → UNKNOWN / OUT_OF_SCOPE
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.55

# File upload limits
MAX_FILE_SIZE_MB=50

# CORS — frontend dev server
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
